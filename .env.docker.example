# Docker Compose project identity
COMPOSE_PROJECT_NAME=govind

# Host port mappings (berbeda dengan stack RRCONS: 8082/3307/1025/8025, jadi keduanya bisa jalan bersamaan)
GOVIND_APP_PORT=8083
# MariaDB untuk `php artisan serve` native (hanya 127.0.0.1); 3306 biasanya dipakai XAMPP
GOVIND_DB_PORT=3308
GOVIND_MAILPIT_SMTP_PORT=1026
GOVIND_MAILPIT_UI_PORT=8026

# Laravel application runtime (nilai lain seperti APP_LOCALE dibaca dari file .env proyek
# yang ikut ter-mount ke container)
GOVIND_APP_NAME=Laravel
GOVIND_APP_ENV=local
# Generate with: docker compose --env-file .env.docker run --rm app php artisan key:generate --show
GOVIND_APP_KEY=
GOVIND_APP_DEBUG=true
GOVIND_APP_URL=http://localhost:8083

# Laravel logging
GOVIND_LOG_CHANNEL=stack
GOVIND_LOG_LEVEL=debug

# Local-only database bootstrap and Laravel connection values.
# Replace both example passwords before the database service is started.
GOVIND_DB_DATABASE=govind
GOVIND_DB_USERNAME=govind
GOVIND_DB_PASSWORD=change-me
GOVIND_DB_ROOT_PASSWORD=change-root-me

# Email lokal ditangkap Mailpit (http://localhost:8026), tidak pernah terkirim keluar
GOVIND_MAIL_FROM_ADDRESS=noreply@govind.local
GOVIND_MAIL_FROM_NAME="Govind Abra Enterprise"
