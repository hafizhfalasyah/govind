{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php artisan test:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan about:*)",
      "Bash(php artisan list:*)",
      "Bash(php artisan optimize:clear:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git remote -v:*)",
      "Bash(docker compose --env-file .env.docker ps:*)",
      "Bash(docker compose --env-file .env.docker logs:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(php artisan migrate:*)",
      "Bash(docker compose --env-file .env.docker down:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.docker)",
      "Read(./.env.production)",
      "Read(./.env.backup)",
      "Read(../deployment/**)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan migrate:refresh:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(php artisan db:seed:*)",
      "Bash(docker compose --env-file .env.docker down -v:*)"
    ]
  }
}
